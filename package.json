{
  "name": "lego-stock-market",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx worker/index.ts",
    "worker:once": "tsx worker/index.ts --once",
    "db:migrate": "tsx scripts/migrate.ts",
    "catalog:import": "tsx scripts/import-catalog.ts",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.1.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "clsx": "^2.1.1",
    "next": "15.5.29",
    "pg": "^8.13.1",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "recharts": "^2.15.1",
    "server-only": "^0.0.1",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.10",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-next": "15.5.29",
    "postcss": "8.5.33",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "overrides": {
    "postcss": "8.5.33"
  }
}
