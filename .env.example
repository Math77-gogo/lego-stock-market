# ---------------------------------------------------------------------------
# LEGO STOCK MARKET — environment template. Copy to .env.local (web) / worker env.
# Never commit real values.
# ---------------------------------------------------------------------------

# production = only official BrickLink rows are read or written. test = local fixtures allowed + TEST MODE banner.
APP_MODE=production

# Postgres (Supabase). Web on Vercel: use the transaction pooler URL (port 6543).
# Worker: the direct or session pooler URL (port 5432).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_POOL_MAX=5

# Supabase Auth (public values; safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# BrickLink API (WORKER ONLY — never set these on the web app)
# Create at https://www.bricklink.com/v2/api/register_consumer.page
BRICKLINK_CONSUMER_KEY=
BRICKLINK_CONSUMER_SECRET=
BRICKLINK_TOKEN_VALUE=
BRICKLINK_TOKEN_SECRET=
BRICKLINK_API_BASE_URL=https://api.bricklink.com/api/store/v1
BRICKLINK_DAILY_REQUEST_LIMIT=5000
BRICKLINK_BUDGET_RESERVE_RATIO=0.15
BRICKLINK_MIN_REQUEST_SPACING_MS=1500
BRICKLINK_REQUEST_TIMEOUT_MS=15000

# Scheduler
SYNC_MIN_INTERVAL_MINUTES=30
SYNC_MAX_INTERVAL_HOURS=24
SYNC_STOCK_GUIDE_ENABLED=true
SYNC_STALE_AFTER_HOURS=36
SYNC_TICK_SECONDS=60

# Web app -> worker (catalog lookups). Same secret on both sides; 32+ random chars:
#   openssl rand -hex 32
WORKER_INTERNAL_URL=https://worker.example.com
WORKER_API_SECRET=
WORKER_PORT=8080

# Local development only (no Supabase): signs in as this auth.users id. Rejected in production.
# LOCAL_DEV_AUTH_USER_ID=
